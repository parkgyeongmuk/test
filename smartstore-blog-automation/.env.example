# ---- 네이버 커머스API센터 (스마트스토어) ----
# apicenter.commerce.naver.com 에서 애플리케이션 등록 후 발급받은 값
NAVER_COMMERCE_CLIENT_ID=
NAVER_COMMERCE_CLIENT_SECRET=
# 판매자 계정 유형: SELF(위탁 없이 본인 계정) 또는 SELLER(대행 계정, ACCOUNT_ID 필요)
NAVER_COMMERCE_ACCOUNT_TYPE=SELF
NAVER_COMMERCE_ACCOUNT_ID=

# ---- 네이버 오픈API (블로그 글쓰기) ----
# developers.naver.com 에서 애플리케이션 등록 후 발급받은 값 (사용 API: 블로그)
NAVER_BLOG_CLIENT_ID=
NAVER_BLOG_CLIENT_SECRET=
# scripts/get_blog_refresh_token.py 를 한 번 실행해서 발급받는 값
NAVER_BLOG_REFRESH_TOKEN=
# 글을 올릴 블로그 아이디(네이버 아이디). 비워두면 로그인한 계정의 블로그에 작성
NAVER_BLOG_ID=

# ---- 리포트 생성 옵션 ----
# 몇 일치 주문을 집계할지 (기본 1 = 전날 하루)
REPORT_DAYS=1
